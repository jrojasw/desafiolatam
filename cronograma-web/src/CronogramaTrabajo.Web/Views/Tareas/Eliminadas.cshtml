@model IEnumerable<Tarea>

@{
    ViewData["Title"] = "Papelera";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Papelera 🗑️</h1>
    <a asp-action="Index" class="btn btn-outline-primary">Volver al listado</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay tareas eliminadas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Título</th>
                    <th>Responsable</th>
                    <th>Estado</th>
                    <th>Eliminada por</th>
                    <th>Fecha de eliminación</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tarea in Model)
                {
                    <tr>
                        <td>@tarea.Titulo</td>
                        <td>@tarea.Responsable</td>
                        <td><span class="badge @tarea.Estado.ClaseBadge()">@tarea.Estado.TextoAmigable()</span></td>
                        <td>@(tarea.EliminadaPor ?? "—")</td>
                        <td>@(tarea.FechaEliminacion?.ToLocalTime().ToString("dd-MM-yyyy HH:mm") ?? "—")</td>
                        <td class="text-end">
                            <form asp-action="Recuperar" asp-route-id="@tarea.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Recuperar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
