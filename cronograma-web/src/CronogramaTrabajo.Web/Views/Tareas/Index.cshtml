@model IEnumerable<Tarea>

@{
    ViewData["Title"] = "Cronograma de trabajo";
    var estadoSeleccionado = ViewBag.EstadoSeleccionado as EstadoTarea?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Cronograma de trabajo</h1>
    <a asp-action="Calendario" class="btn btn-outline-primary">Ver calendario</a>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(estadoSeleccionado is null ? "active" : "")" asp-action="Index">Todas</a>
    </li>
    @foreach (var estado in Enum.GetValues<EstadoTarea>())
    {
        <li class="nav-item">
            <a class="nav-link @(estadoSeleccionado == estado ? "active" : "")" asp-action="Index" asp-route-estado="@estado">
                @estado.TextoAmigable()
            </a>
        </li>
    }
</ul>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay tareas registradas para este estado.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Título</th>
                    <th>Responsable</th>
                    <th>Inicio</th>
                    <th>Término</th>
                    <th>Prioridad</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tarea in Model)
                {
                    <tr>
                        <td>@tarea.Titulo</td>
                        <td>@tarea.Responsable</td>
                        <td>@tarea.FechaInicio.ToString("dd-MM-yyyy")</td>
                        <td>@tarea.FechaFin.ToString("dd-MM-yyyy")</td>
                        <td><span class="badge @tarea.Prioridad.ClaseBadgePrioridad()">@tarea.Prioridad.TextoAmigable()</span></td>
                        <td><span class="badge @tarea.Estado.ClaseBadge()">@tarea.Estado.TextoAmigable()</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@tarea.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@tarea.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@tarea.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
