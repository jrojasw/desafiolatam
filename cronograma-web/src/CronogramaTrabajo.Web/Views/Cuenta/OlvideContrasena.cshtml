@model OlvideContrasenaViewModel

@{
    ViewData["Title"] = "Olvidé mi contraseña";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="text-center mb-4">
            <img src="~/img/logo-cpynos.png" alt="CPY NOS" style="height: 80px;" />
        </div>
        <h1 class="h3 mb-3 text-center">¿Olvidaste tu contraseña?</h1>
        <p class="text-muted text-center mb-4">Ingresa tu correo y te enviaremos un enlace para crear una nueva contraseña.</p>

        <form asp-action="OlvideContrasena" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" autofocus />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-acento w-100">Enviar enlace</button>
        </form>

        <p class="mt-3 text-center">
            <a asp-action="IniciarSesion">Volver a iniciar sesión</a>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
