@model RegistrarViewModel

@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-4">Crear cuenta</h1>

        <form asp-action="Registrar" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <input asp-for="NombreCompleto" class="form-control" autofocus />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" placeholder="nombre@copayapunos.cl" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contrasena" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Contrasena" class="form-control" />
                    <button type="button" class="btn btn-outline-secondary toggle-password" data-target="Contrasena">👁</button>
                </div>
                <span asp-validation-for="Contrasena" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmarContrasena" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="ConfirmarContrasena" class="form-control" />
                    <button type="button" class="btn btn-outline-secondary toggle-password" data-target="ConfirmarContrasena">👁</button>
                </div>
                <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Registrarme</button>
        </form>

        <p class="mt-3 text-center">
            ¿Ya tienes cuenta? <a asp-action="IniciarSesion">Inicia sesión</a>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
