@model NewsFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "Nueva noticia" : "Editar noticia";
}

<div class="cp-form-card" style="max-width:700px;">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <form asp-action="Save" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
        {
            <img src="@Url.Content(Model.CurrentImagePath)" class="mb-3" style="max-width:100%;max-height:220px;object-fit:cover;border-radius:.6rem;" />
        }
        <div class="mb-3">
            <label asp-for="Image" class="form-label"></label>
            <input asp-for="Image" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
        </div>
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Category" class="form-label"></label>
            <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<NewsCategory>()"></select>
        </div>
        <div class="mb-3">
            <label asp-for="Summary" class="form-label"></label>
            <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Summary" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Content" class="form-label"></label>
            <textarea asp-for="Content" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Content" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SourceUrl" class="form-label"></label>
            <input asp-for="SourceUrl" class="form-control" />
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
        <button type="submit" class="btn cp-btn-primary">Guardar</button>
        <a asp-action="Index" class="btn cp-btn-outline">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
