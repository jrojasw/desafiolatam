@model List<Appointment>
@using CentralPsi.Web.Models.Entities
@using CentralPsi.Web.Services
@{
    ViewData["Title"] = "Pagos a profesionales";
    var filter = ViewData["Filter"] as string ?? "pendientes";
    var range = ViewData["Range"] as string ?? "todos";
    var payoutBusinessDays = (int)(ViewData["PayoutBusinessDays"] ?? 3);
    var totalPendiente = (decimal)(ViewData["TotalPendiente"] ?? 0m);
    var culture = new System.Globalization.CultureInfo("es-CL");
    var now = DateTime.UtcNow;

    (string CssClass, string Label) Urgency(Appointment a)
    {
        var businessDays = BusinessDayCalculator.BusinessDaysElapsed(a.ScheduledEndUtc, now);
        return businessDays switch
        {
            <= 1 => ("cp-urgency-green", "1 día"),
            var d when d == payoutBusinessDays => ("cp-urgency-red", "Último día"),
            var d when d < payoutBusinessDays => ("cp-urgency-yellow", "Por vencer"),
            _ => ("cp-urgency-overdue", $"Vencido {businessDays - payoutBusinessDays} día(s)")
        };
    }
}

<div class="cp-crisis-notice mb-4" style="background:#eef6f5;color:var(--cp-primary-dark);">
    Cuando llegue una boleta a <a href="mailto:pagos@centralpsi.cl">pagos@centralpsi.cl</a>, busca la sesión
    correspondiente abajo, revisa los datos bancarios del profesional y, una vez hecha la transferencia,
    márcala como pagada. Recuerda el compromiso de transferir dentro de @payoutBusinessDays días hábiles desde
    que se realiza la sesión. La columna "Plazo" muestra un punto verde mientras hay margen, amarillo
    ("Por vencer") al segundo día, rojo ("Último día") el día @payoutBusinessDays, y un punto rojo/azul
    parpadeante ("Vencido") si ya nos pasamos del plazo.
</div>

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" asp-route-filter="pendientes" asp-route-range="@range" class="btn btn-sm @(filter == "pendientes" ? "cp-btn-primary" : "cp-btn-outline")">Pendientes</a>
        <a asp-action="Index" asp-route-filter="pagados" asp-route-range="@range" class="btn btn-sm @(filter == "pagados" ? "cp-btn-primary" : "cp-btn-outline")">Pagados</a>
        <a asp-action="Index" asp-route-filter="todos" asp-route-range="@range" class="btn btn-sm @(filter == "todos" ? "cp-btn-primary" : "cp-btn-outline")">Todos</a>
    </div>
    <div class="fw-bold">Total pendiente de pago: $@totalPendiente.ToString("N0") CLP</div>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <a asp-action="Index" asp-route-filter="@filter" asp-route-range="hoy" class="btn btn-sm @(range == "hoy" ? "cp-btn-primary" : "cp-btn-outline")">Hoy</a>
    <a asp-action="Index" asp-route-filter="@filter" asp-route-range="ayer" class="btn btn-sm @(range == "ayer" ? "cp-btn-primary" : "cp-btn-outline")">Ayer</a>
    <a asp-action="Index" asp-route-filter="@filter" asp-route-range="antesdeayer" class="btn btn-sm @(range == "antesdeayer" ? "cp-btn-primary" : "cp-btn-outline")">Antes de ayer</a>
    <a asp-action="Index" asp-route-filter="@filter" asp-route-range="semana" class="btn btn-sm @(range == "semana" ? "cp-btn-primary" : "cp-btn-outline")">Esta semana</a>
    <a asp-action="Index" asp-route-filter="@filter" asp-route-range="mes" class="btn btn-sm @(range == "mes" ? "cp-btn-primary" : "cp-btn-outline")">Este mes</a>
    <a asp-action="Index" asp-route-filter="@filter" asp-route-range="anio" class="btn btn-sm @(range == "anio" ? "cp-btn-primary" : "cp-btn-outline")">Este año</a>
    <a asp-action="Index" asp-route-filter="@filter" asp-route-range="todos" class="btn btn-sm @(range == "todos" ? "cp-btn-primary" : "cp-btn-outline")">Todo</a>
</div>

<div class="table-responsive">
    <table class="table cp-admin-table align-middle bg-white">
        <thead>
            <tr>
                <th>Sesión</th><th>Profesional</th><th>Paciente</th><th>Monto sesión</th>
                <th>A pagar profesional</th><th>Datos bancarios</th><th>Estado</th><th>Plazo</th><th>Comprobante</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                var p = a.Professional!;
                <tr>
                    <td>@a.ScheduledStartUtc.ToLocalTime().ToString("dd-MM-yyyy HH:mm", culture)</td>
                    <td>@p.FullName</td>
                    <td>
                        @if (a.IsForMinor)
                        {
                            <span>@a.MinorFullName (@a.MinorAge años)</span>
                            <br /><span class="text-muted small">A cargo de @a.PatientFullName</span>
                        }
                        else
                        {
                            @a.PatientFullName
                        }
                    </td>
                    <td>$@a.Amount.ToString("N0")</td>
                    <td>$@a.ProfessionalPayoutAmount.ToString("N0")</td>
                    <td class="small">
                        @if (string.IsNullOrWhiteSpace(p.BankAccountNumber))
                        {
                            <span class="text-muted">Sin datos bancarios registrados</span>
                        }
                        else
                        {
                            <span>@p.BankName - @p.BankAccountType</span>
                            <br />
                            <span>N° @p.BankAccountNumber</span>
                            <br />
                            <span>@p.BankAccountHolderName (RUT @p.BankAccountHolderRut)</span>
                        }
                    </td>
                    <td>
                        @if (a.ProfessionalPaidAtUtc is not null)
                        {
                            <span class="cp-status-pill cp-status-verified">Pagado</span>
                            <div class="small text-muted">@a.ProfessionalPaidAtUtc.Value.ToLocalTime().ToString("dd-MM-yyyy")</div>
                            @if (!string.IsNullOrWhiteSpace(a.ProfessionalPaymentNote))
                            {
                                <div class="small text-muted">@a.ProfessionalPaymentNote</div>
                            }
                        }
                        else
                        {
                            <span class="cp-status-pill cp-status-pending">Pendiente</span>
                        }
                    </td>
                    <td>
                        @if (a.ProfessionalPaidAtUtc is null)
                        {
                            var (cssClass, label) = Urgency(a);
                            <span class="cp-urgency @cssClass">
                                <span>@label</span>
                                <span class="cp-urgency-dot"></span>
                            </span>
                        }
                        else
                        {
                            <span class="text-muted small">-</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(a.ProfessionalPaymentReceiptPath))
                        {
                            <a asp-action="Receipt" asp-route-id="@a.Id" target="_blank" class="btn btn-sm cp-btn-outline">Ver comprobante</a>
                        }
                        else if (a.ProfessionalPaidAtUtc is not null)
                        {
                            <span class="text-muted small">Sin comprobante</span>
                        }
                        else
                        {
                            <span class="text-muted small">-</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (a.ProfessionalPaidAtUtc is null)
                        {
                            <form asp-action="MarkPaid" asp-route-id="@a.Id" method="post" enctype="multipart/form-data" class="cp-mark-paid-form d-flex flex-column gap-1 align-items-end">
                                <input type="text" name="note" class="form-control form-control-sm" placeholder="Nota (opcional)" style="max-width:170px;" />
                                <input type="file" name="receipt" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.webp" style="max-width:170px;" required title="Comprobante de la transferencia (obligatorio)" />
                                <button type="submit" class="btn btn-sm cp-btn-primary" disabled>Marcar pagado</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="MarkPending" asp-route-id="@a.Id" method="post">
                                <button type="submit" class="btn btn-sm cp-btn-outline">Deshacer</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Count == 0)
    {
        <p class="text-muted">No hay sesiones en este filtro.</p>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.cp-mark-paid-form').forEach(function (form) {
            var fileInput = form.querySelector('input[type="file"]');
            var submitButton = form.querySelector('button[type="submit"]');
            fileInput.addEventListener('change', function () {
                submitButton.disabled = fileInput.files.length === 0;
            });
        });
    </script>
}
