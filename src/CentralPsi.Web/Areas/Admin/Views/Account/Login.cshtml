@model LoginViewModel
@{
    ViewData["Title"] = "Ingreso administrador";
    Layout = "_AuthLayout";
}

<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autofocus />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
    </div>
    <div class="form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn cp-btn-primary w-100">Ingresar</button>
    <div class="text-center mt-3">
        <a asp-action="ForgotPassword" class="small">¿Olvidaste tu contraseña?</a>
    </div>
</form>
