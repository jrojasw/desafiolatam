@{
    ViewData["Title"] = "Google Calendar conectado";
    string? connectedEmail = ViewBag.ConnectedEmail;
}

<div class="cp-form-card" style="max-width:680px;">
    <h4 class="mb-3">✅ Cuenta de Google conectada</h4>
    @if (!string.IsNullOrWhiteSpace(connectedEmail))
    {
        <p>Conectado como <strong>@connectedEmail</strong>.</p>
    }
    else
    {
        <p class="text-muted small">
            Quedó conectado, aunque no pudimos confirmar automáticamente el correo de la cuenta - puedes
            verificarlo con el botón "Probar conexión" en la página anterior.
        </p>
    }
    <p class="text-muted small">
        El refresh token quedó guardado de forma cifrada en la base de datos - no necesitas copiarlo ni agregarlo
        como variable de entorno. Desde ahora las citas confirmadas deberían generar su enlace de Google Meet.
    </p>
    <a asp-action="Index" class="btn cp-btn-outline">Volver</a>
</div>
