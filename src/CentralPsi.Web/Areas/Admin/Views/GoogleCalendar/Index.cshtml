@{
    ViewData["Title"] = "Google Calendar / Meet";
    bool hasClientCredentials = ViewBag.HasClientCredentials;
    bool hasRefreshToken = ViewBag.HasRefreshToken;
    string tokenSource = ViewBag.TokenSource;
    DateTime? tokenUpdatedAtUtc = ViewBag.TokenUpdatedAtUtc;
    bool enabled = ViewBag.Enabled;
    string redirectUri = ViewBag.RedirectUri;
    DateTime? lastEventSuccessAtUtc = ViewBag.LastEventSuccessAtUtc;
    DateTime? lastEventErrorAtUtc = ViewBag.LastEventErrorAtUtc;
    string? lastEventErrorMessage = ViewBag.LastEventErrorMessage;
}

<div class="cp-form-card" style="max-width:680px;">
    <h4 class="mb-3">Conectar Google Calendar / Meet</h4>
    <p class="text-muted small">
        Esto permite que CentralPsi cree automáticamente un evento con enlace de Google Meet cada vez que se
        confirma una hora, usando una cuenta de Google normal (no requiere Google Workspace).
    </p>

    <table class="table table-sm">
        <tbody>
            <tr>
                <td>Client ID / Secret configurados</td>
                <td>@(hasClientCredentials ? "✅ Sí" : "❌ No — falta agregarlos en las variables de entorno")</td>
            </tr>
            <tr>
                <td>Cuenta de Google conectada (refresh token)</td>
                <td>
                    @(hasRefreshToken ? "✅ Sí" : "❌ No")
                    @if (hasRefreshToken)
                    {
                        <span class="text-muted small">
                            (@tokenSource@(tokenUpdatedAtUtc is DateTime u ? $", guardado el {u:yyyy-MM-dd HH:mm} UTC" : ""))
                        </span>
                    }
                </td>
            </tr>
            <tr>
                <td>Integración habilitada (GoogleCalendar:Enabled)</td>
                <td>@(enabled ? "✅ Sí" : "❌ No")</td>
            </tr>
            <tr>
                <td>Último evento creado con éxito</td>
                <td>@(lastEventSuccessAtUtc is DateTime s ? $"{s:yyyy-MM-dd HH:mm} UTC" : "— (ninguno registrado todavía)")</td>
            </tr>
            <tr>
                <td>Último error al crear un evento</td>
                <td>
                    @if (lastEventErrorAtUtc is DateTime e)
                    {
                        <span class="text-danger">@e.ToString("yyyy-MM-dd HH:mm") UTC</span>
                        @if (!string.IsNullOrWhiteSpace(lastEventErrorMessage))
                        {
                            <div class="text-muted small">@lastEventErrorMessage</div>
                        }
                    }
                    else
                    {
                        @:— (ninguno registrado)
                    }
                </td>
            </tr>
        </tbody>
    </table>

    @if (!hasClientCredentials)
    {
        <div class="alert alert-warning small">
            Falta crear el Client ID/Secret en Google Cloud Console y agregarlos como variables de entorno
            <code>GoogleCalendar__ClientId</code> y <code>GoogleCalendar__ClientSecret</code>. El "Authorized
            redirect URI" que debes registrar en Google Cloud es:
            <br /><code>@redirectUri</code>
        </div>
    }
    else
    {
        <a asp-action="Connect" class="btn cp-btn-primary">
            @(hasRefreshToken ? "Reconectar cuenta de Google" : "Conectar cuenta de Google")
        </a>

        <form asp-action="TestConnection" method="post" class="mt-2">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn cp-btn-outline">Probar conexión</button>
        </form>
    }
</div>
