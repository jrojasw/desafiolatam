@model CentralPsi.Web.Models.ViewModels.ProfessionalRegisterViewModel
@{
    ViewData["Title"] = "Inscripción de profesionales";
    var dayNames = new Dictionary<DayOfWeek, string>
    {
        [DayOfWeek.Monday] = "Lunes",
        [DayOfWeek.Tuesday] = "Martes",
        [DayOfWeek.Wednesday] = "Miércoles",
        [DayOfWeek.Thursday] = "Jueves",
        [DayOfWeek.Friday] = "Viernes",
        [DayOfWeek.Saturday] = "Sábado",
        [DayOfWeek.Sunday] = "Domingo",
    };
}

<section class="cp-section">
    <div class="container" style="max-width:820px;">
        <h1 class="cp-section-title">Inscripción gratuita de profesionales</h1>
        <p class="cp-section-subtitle">
            Completa tus datos y adjunta tu documentación. Validaremos automáticamente tu certificado del
            Ministerio de Salud contra la Superintendencia de Salud; si todo está en orden, tu perfil se publicará
            en <strong>Nuestros profesionales</strong> y te avisaremos por correo.
        </p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-action="Register" method="post" enctype="multipart/form-data" class="cp-form-card">
            <h5 class="mb-3">Datos personales</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Rut" class="form-label"></label>
                    <input asp-for="Rut" class="form-control" placeholder="12.345.678-9" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" placeholder="+56 9 ..." />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Specialty" class="form-label"></label>
                    <input asp-for="Specialty" class="form-control" placeholder="Ej: Psicología infantil" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Orientation" class="form-label"></label>
                    <input asp-for="Orientation" class="form-control" placeholder="Ej: Cognitivo-conductual" />
                    <span asp-validation-for="Orientation" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Experience" class="form-label"></label>
                    <textarea asp-for="Experience" class="form-control" rows="4" placeholder="Cuéntanos tu formación y experiencia; esto se mostrará en tu perfil público."></textarea>
                    <span asp-validation-for="Experience" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="ProfilePhoto" class="form-label"></label>
                    <input asp-for="ProfilePhoto" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                </div>
            </div>

            <hr class="my-4" />
            <h5 class="mb-3">Documentación</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CedulaFront" class="form-label"></label>
                    <input asp-for="CedulaFront" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                    <span asp-validation-for="CedulaFront" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CedulaBack" class="form-label"></label>
                    <input asp-for="CedulaBack" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                    <span asp-validation-for="CedulaBack" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CertificateFile" class="form-label"></label>
                    <input asp-for="CertificateFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                    <span asp-validation-for="CertificateFile" class="text-danger small"></span>
                    <div class="form-text">Sube el certificado emitido por la Superintendencia de Salud (idealmente en imagen, para poder leer su código QR automáticamente).</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="CertificateValidationCode" class="form-label"></label>
                    <input asp-for="CertificateValidationCode" class="form-control" />
                    <span asp-validation-for="CertificateValidationCode" class="text-danger small"></span>
                    <div class="form-text">Es el código que aparece en tu certificado para validarlo en emisorcertificados.superdesalud.gob.cl</div>
                </div>
            </div>

            <hr class="my-4" />
            <h5 class="mb-3">Horario de atención</h5>
            <p class="text-muted small">Marca los días y define el rango horario en que las personas podrán agendar contigo.</p>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr><th></th><th>Día</th><th>Desde</th><th>Hasta</th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Availability.Count; i++)
                        {
                            <tr>
                                <td><input type="checkbox" class="form-check-input" asp-for="Availability[i].Enabled" /></td>
                                <td>
                                    @dayNames[Model.Availability[i].DayOfWeek]
                                    <input type="hidden" asp-for="Availability[i].DayOfWeek" />
                                </td>
                                <td><input type="time" class="form-control form-control-sm" asp-for="Availability[i].StartTime" /></td>
                                <td><input type="time" class="form-control form-control-sm" asp-for="Availability[i].EndTime" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <button type="submit" class="btn cp-btn-primary btn-lg mt-3">Enviar inscripción</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
