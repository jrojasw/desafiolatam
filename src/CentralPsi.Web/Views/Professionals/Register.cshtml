@model CentralPsi.Web.Models.ViewModels.ProfessionalRegisterViewModel
@{
    ViewData["Title"] = "Inscripción de profesionales";
    var dayNames = new Dictionary<DayOfWeek, string>
    {
        [DayOfWeek.Monday] = "Lunes",
        [DayOfWeek.Tuesday] = "Martes",
        [DayOfWeek.Wednesday] = "Miércoles",
        [DayOfWeek.Thursday] = "Jueves",
        [DayOfWeek.Friday] = "Viernes",
        [DayOfWeek.Saturday] = "Sábado",
        [DayOfWeek.Sunday] = "Domingo",
    };
    var appOptions = (CentralPsi.Web.Options.AppOptions)ViewBag.AppOptions;
    var clCulture = new System.Globalization.CultureInfo("es-CL");
}

<div class="modal fade" id="cpPagoInfoModal" tabindex="-1" aria-labelledby="cpPagoInfoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cp-pago-modal">
            <div class="cp-pago-modal__bar">
                <span id="cpPagoInfoModalLabel">Las cuentas claras conservan la amistad</span>
                <button type="button" class="btn-close btn-close-white cp-pago-modal__close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="cp-pago-modal__body">
                <p class="mb-3">
                    Por cada sesión, tú recibes <strong>$@appOptions.ProfessionalPayoutClp.ToString("N0", clCulture) líquidos</strong>.
                </p>
                <p class="mb-4">
                    Ese pago se transfiere a tu cuenta en un plazo máximo de
                    <strong>@appOptions.ProfessionalPayoutBusinessDays días hábiles</strong>, una vez que nos envíes
                    la misma boleta de honorarios que le entregaste al paciente.
                </p>
                <button type="button" class="btn cp-btn-primary" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

<section class="cp-section">
    <div class="container" style="max-width:820px;">
        <h1 class="cp-section-title">Inscripción gratuita de profesionales</h1>
        <p class="cp-section-subtitle">
            Completa tus datos y adjunta tu documentación. Validaremos automáticamente tu certificado del
            Ministerio de Salud contra la Superintendencia de Salud; si todo está en orden, tu perfil se publicará
            en <strong>Profesionales disponibles</strong> y te avisaremos por correo.
        </p>

        <div class="cp-crisis-notice mb-4" style="background:#eef6f5;color:var(--cp-primary-dark);">
            <strong>Requisito importante:</strong> para poder pagarte tu parte de cada sesión, necesitas contar con
            <strong>Inicio de Actividades vigente en el SII</strong> y emitir una boleta de honorarios <strong>a
            nombre del paciente atendido</strong> por el monto correspondiente. Después de cada sesión, envía esa
            boleta al paciente y, además, una copia a <a href="mailto:pagos@centralpsi.cl">pagos@centralpsi.cl</a>
            — con los datos bancarios que dejas más abajo, te transferiremos tu pago dentro de un plazo de
            <strong>3 días hábiles</strong>. Si aún no tienes Inicio de Actividades, revisa
            <a asp-action="IniciacionActividades">cómo hacerlo paso a paso</a> antes de completar esta inscripción.
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-action="Register" method="post" enctype="multipart/form-data" class="cp-form-card">
            <h5 class="mb-3">Datos personales</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Rut" class="form-label"></label>
                    <input asp-for="Rut" class="form-control" placeholder="12.345.678-9" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" placeholder="+56 9 ..." />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Specialty" class="form-label"></label>
                    <input asp-for="Specialty" class="form-control" placeholder="Ej: Psicología infantil" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Orientation" class="form-label"></label>
                    <select asp-for="Orientation" class="form-select" id="orientationSelect">
                        <option value="">Selecciona una opción</option>
                        @foreach (var option in CentralPsi.Web.Models.ViewModels.ProfessionalRegisterViewModel.OrientationOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                    <span asp-validation-for="Orientation" class="text-danger small"></span>
                </div>
                <div class="col-md-6 d-none" id="orientationOtherWrapper">
                    <label asp-for="OrientationOther" class="form-label"></label>
                    <input asp-for="OrientationOther" class="form-control" placeholder="Escribe tu orientación" />
                    <span asp-validation-for="OrientationOther" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Experience" class="form-label"></label>
                    <div class="form-text mb-1">
                        Cuéntale a quien te va a agendar cómo trabajas: tu formación, tu enfoque en sesión, con
                        qué temas o poblaciones tienes más experiencia, etc. Este texto se muestra tal cual en
                        tu perfil público, así que evita dejarlo vacío o genérico.
                    </div>
                    <textarea asp-for="Experience" class="form-control" rows="4" placeholder="Ej: Soy psicólogo clínico con 5 años de experiencia trabajando con adultos jóvenes, con enfoque cognitivo-conductual. En sesión priorizo un espacio cercano y sin juicios, trabajando con metas concretas..."></textarea>
                    <span asp-validation-for="Experience" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="ProfilePhoto" class="form-label"></label>
                    <input asp-for="ProfilePhoto" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                </div>
            </div>

            <hr class="my-4" />
            <h5 class="mb-3">Documentación</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CedulaFront" class="form-label"></label>
                    <input asp-for="CedulaFront" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                    <span asp-validation-for="CedulaFront" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CedulaBack" class="form-label"></label>
                    <input asp-for="CedulaBack" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                    <span asp-validation-for="CedulaBack" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CertificateFile" class="form-label"></label>
                    <input asp-for="CertificateFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                    <span asp-validation-for="CertificateFile" class="text-danger small"></span>
                    <div class="form-text">Sube el certificado emitido por la Superintendencia de Salud (idealmente en imagen, para poder leer su código QR automáticamente). Debe estar <strong>vigente y actualizado</strong>.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="CertificateValidationCode" class="form-label"></label>
                    <input asp-for="CertificateValidationCode" class="form-control" />
                    <span asp-validation-for="CertificateValidationCode" class="text-danger small"></span>
                    <div class="form-text">Es el código que aparece en tu certificado para validarlo en emisorcertificados.superdesalud.gob.cl</div>
                </div>
            </div>

            <hr class="my-4" />
            <h5 class="mb-3">Datos bancarios para el pago</h5>
            <p class="text-muted small">
                Aquí transferiremos tu parte de cada sesión. <strong>La cuenta debe estar a tu propio nombre y RUT</strong>
                — no aceptamos cuentas de terceros ni de sociedades. Si no tienes cuenta bancaria, puedes solicitar
                una Cuenta RUT gratuita en BancoEstado. Estos datos no se muestran en tu perfil público.
            </p>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="BankName" class="form-label"></label>
                    <input asp-for="BankName" class="form-control" placeholder="Ej: Banco Estado" />
                    <span asp-validation-for="BankName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BankAccountType" class="form-label"></label>
                    <select asp-for="BankAccountType" class="form-select">
                        <option value="">Selecciona una opción</option>
                        @foreach (var option in CentralPsi.Web.Models.ViewModels.ProfessionalRegisterViewModel.BankAccountTypeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                    <span asp-validation-for="BankAccountType" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BankAccountNumber" class="form-label"></label>
                    <input asp-for="BankAccountNumber" class="form-control" />
                    <span asp-validation-for="BankAccountNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BankAccountHolderRut" class="form-label"></label>
                    <input asp-for="BankAccountHolderRut" class="form-control" placeholder="12.345.678-9" />
                    <span asp-validation-for="BankAccountHolderRut" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="BankAccountHolderName" class="form-label"></label>
                    <input asp-for="BankAccountHolderName" class="form-control" />
                    <span asp-validation-for="BankAccountHolderName" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />
            <h5 class="mb-3">Horario de atención</h5>
            <p class="text-muted small">Marca los días y define el rango horario en que las personas podrán agendar contigo.</p>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr><th></th><th>Día</th><th>Desde</th><th>Hasta</th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Availability.Count; i++)
                        {
                            <tr>
                                <td><input type="checkbox" class="form-check-input" asp-for="Availability[i].Enabled" /></td>
                                <td>
                                    @dayNames[Model.Availability[i].DayOfWeek]
                                    <input type="hidden" asp-for="Availability[i].DayOfWeek" />
                                </td>
                                <td><input type="time" class="form-control form-control-sm" asp-for="Availability[i].StartTime" /></td>
                                <td><input type="time" class="form-control form-control-sm" asp-for="Availability[i].EndTime" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-check my-3">
                <input asp-for="TaxComplianceAccepted" class="form-check-input" />
                <label asp-for="TaxComplianceAccepted" class="form-check-label small"></label>
                <div><span asp-validation-for="TaxComplianceAccepted" class="text-danger small"></span></div>
                <div class="small mt-1">
                    <a asp-action="CondicionesPago" target="_blank" rel="noopener">Ver el detalle completo de cómo funcionan los pagos</a>
                </div>
            </div>

            <div class="form-text mt-3 mb-2">
                <strong>Revisa bien tus datos antes de enviar: una vez inscrito/a, si necesitas modificar algo de tu
                perfil (foto, descripción, orientación, horarios, etc.) deberás escribirnos a
                <a href="mailto:admin@centralpsi.cl">admin@centralpsi.cl</a>.</strong>
            </div>
            <button type="submit" class="btn cp-btn-primary btn-lg">Enviar inscripción</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var select = document.getElementById('orientationSelect');
            var wrapper = document.getElementById('orientationOtherWrapper');
            function toggle() {
                wrapper.classList.toggle('d-none', select.value !== 'Otro');
            }
            select.addEventListener('change', toggle);
            toggle();
        })();
        (function () {
            var modalEl = document.getElementById('cpPagoInfoModal');
            if (modalEl && window.bootstrap) {
                new bootstrap.Modal(modalEl).show();
            }
        })();
    </script>
}
