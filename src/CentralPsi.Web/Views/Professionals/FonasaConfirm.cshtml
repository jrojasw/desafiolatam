@model CentralPsi.Web.Models.ViewModels.ProfessionalFonasaConfirmationViewModel
@{
    ViewData["Title"] = "Confirma tu inscripción en Fonasa";
}

<section class="cp-section">
    <div class="container" style="max-width:640px;">
        <h1 class="cp-section-title">Confirma tu inscripción en Fonasa</h1>

        @if (Model.LinkInvalid)
        {
            <div class="cp-form-card">
                <div class="alert alert-warning mb-0">
                    Este enlace ya no es válido. Si necesitas actualizar tu situación en Fonasa, escríbenos a
                    <a href="mailto:admin@centralpsi.cl">admin@centralpsi.cl</a>.
                </div>
            </div>
        }
        else
        {
            <p class="cp-section-subtitle">
                Hola @Model.Professional.FullName, indícanos si actualmente estás inscrito/a en Fonasa. Esta
                información se mostrará en tu perfil público.
            </p>
            <div class="cp-form-card">
                @if (Model.AlreadyAnswered)
                {
                    <div class="alert alert-info">
                        Ya registramos tu respuesta: actualmente figuras como
                        <strong>@(Model.Professional.IsFonasaRegistered ? "inscrito/a" : "no inscrito/a")</strong>
                        en Fonasa. Si esto cambia, vuelve a usar este mismo enlace.
                    </div>
                }
                <form asp-action="FonasaConfirmSubmit" method="post" class="d-flex gap-3 flex-wrap">
                    <button type="submit" name="isFonasaRegistered" value="true" class="btn cp-btn-primary btn-lg">Sí, estoy inscrito/a</button>
                    <button type="submit" name="isFonasaRegistered" value="false" class="btn cp-btn-outline btn-lg">No estoy inscrito/a</button>
                </form>
            </div>
        }
    </div>
</section>
