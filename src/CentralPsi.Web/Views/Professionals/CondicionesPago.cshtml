@model CentralPsi.Web.Options.AppOptions
@{
    ViewData["Title"] = "Cómo funcionan los pagos";
    var clCulture = new System.Globalization.CultureInfo("es-CL");
}

<section class="cp-section">
    <div class="container" style="max-width:820px;">
        <h1 class="cp-section-title">Cómo funcionan los pagos en CentralPsi</h1>
        <p class="cp-section-subtitle">
            El pago de cada sesión no es automático: depende de que envíes tu boleta de honorarios. Así funciona,
            paso a paso.
        </p>

        <div class="d-flex flex-column gap-3 mb-5">
            <div class="cp-form-card d-flex gap-3 align-items-start">
                <div class="fs-3 fw-bold" style="color:var(--cp-primary-dark);min-width:2.5rem;">1</div>
                <div>
                    <strong>El paciente paga $@Model.AppointmentPriceClp.ToString("N0", clCulture) al agendar la hora</strong>
                    <p class="text-muted small mb-0">
                        El pago se hace directo por el sitio con Webpay Plus (Transbank), y queda registrado en
                        CentralPsi.
                    </p>
                </div>
            </div>
            <div class="cp-form-card d-flex gap-3 align-items-start">
                <div class="fs-3 fw-bold" style="color:var(--cp-primary-dark);min-width:2.5rem;">2</div>
                <div>
                    <strong>Emites tu boleta de honorarios al paciente por $@Model.AppointmentPriceClp.ToString("N0", clCulture)</strong>
                    <p class="text-muted small mb-0">
                        La boleta va por el <strong>monto total de la sesión</strong> (no solo tu parte) — así el
                        paciente cuenta con el respaldo completo de lo que pagó, por ejemplo para un reembolso de
                        Isapre.
                    </p>
                </div>
            </div>
            <div class="cp-form-card d-flex gap-3 align-items-start">
                <div class="fs-3 fw-bold" style="color:var(--cp-primary-dark);min-width:2.5rem;">3</div>
                <div>
                    <strong>Envías la boleta al paciente y a pagos@centralpsi.cl</strong>
                    <p class="text-muted small mb-0">
                        Incluye la fecha de la sesión y el nombre del paciente para que podamos identificarla
                        rápido.
                    </p>
                </div>
            </div>
            <div class="cp-form-card d-flex gap-3 align-items-start">
                <div class="fs-3 fw-bold" style="color:var(--cp-primary-dark);min-width:2.5rem;">4</div>
                <div>
                    <strong>Cotejamos tu boleta contra el pago recibido</strong>
                    <p class="text-muted small mb-0">
                        Nuestro equipo revisa que el paciente, el monto y la fecha coincidan con el pago registrado
                        en el sistema.
                    </p>
                </div>
            </div>
            <div class="cp-form-card d-flex gap-3 align-items-start">
                <div class="fs-3 fw-bold" style="color:var(--cp-primary-dark);min-width:2.5rem;">5</div>
                <div>
                    <strong>Liberamos tu pago: $@Model.ProfessionalPayoutClp.ToString("N0", clCulture) líquido</strong>
                    <p class="text-muted small mb-0">
                        Dentro de un plazo máximo de @Model.ProfessionalPayoutBusinessDays días hábiles desde que
                        recibimos tu boleta, transferimos tu pago a la cuenta que indicaste al inscribirte.
                    </p>
                </div>
            </div>
        </div>

        <div class="cp-crisis-notice mb-4" style="background:#fff4e5;color:#8a5300;">
            <strong>Importante:</strong> si no envías tu boleta a pagos@centralpsi.cl, no podemos liberar tu pago —
            es un paso obligatorio, no automático.
        </div>

        <div class="cp-crisis-notice mb-4" style="background:#eef6f5;color:var(--cp-primary-dark);">
            Esta página es un resumen general para orientarte, no reemplaza la asesoría de un contador. Si tienes
            dudas sobre tu situación tributaria particular, te recomendamos consultar con uno antes de inscribirte.
        </div>

        <div class="d-flex gap-2 flex-wrap mt-4">
            <a asp-action="Register" class="btn cp-btn-primary">Volver a la inscripción</a>
        </div>
    </div>
</section>
