@inject Microsoft.Extensions.Options.IOptions<CentralPsi.Web.Options.AnalyticsOptions> AnalyticsOpts
@inject Microsoft.Extensions.Options.IOptions<CentralPsi.Web.Options.AppOptions> LayoutAppOpts
@{
    var gaId = AnalyticsOpts.Value.GoogleAnalyticsId;
    var metaPixelId = AnalyticsOpts.Value.MetaPixelId;
    var hasAnalytics = !string.IsNullOrWhiteSpace(gaId) || !string.IsNullOrWhiteSpace(metaPixelId);
    // Canonical siempre se arma desde la BaseUrl configurada (https://www.centralpsi.cl), nunca desde el host
    // real de la request - así nunca puede apuntar accidentalmente a la versión sin "www" (hoy da 404) ni a
    // http, sin importar cómo haya llegado la visita. Se excluye el query string a propósito.
    var canonicalUrl = $"{LayoutAppOpts.Value.BaseUrl.TrimEnd('/')}{Context.Request.Path}";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CentralPsi</title>
    <meta name="description" content="CentralPsi conecta pacientes con psicólogos verificados por el Ministerio de Salud. Agenda tu hora online de forma simple y segura." />
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="icon" type="image/svg+xml" href="~/images/favicon-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="cp-header">
        <nav class="navbar navbar-expand-lg cp-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index" title="Inicio">
                    <img src="~/images/logo.svg" alt="CentralPsi" height="42" />
                </a>
                <div class="d-flex align-items-center gap-2 order-lg-3">
                    <!-- CTA de campaña de reclutamiento: visible junto al logo en móvil/tablet mientras
                         reclutamos profesionales. Cambiar a "Agendar" (Professionals/Index) cuando haya
                         al menos 15 profesionales inscritos. -->
                    <a class="btn cp-btn-accent btn-sm d-lg-none" asp-area="" asp-controller="Professionals" asp-action="Register">Soy psicólogo/a</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#cpNavbar" aria-controls="cpNavbar" aria-expanded="false" aria-label="Abrir menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
                <div class="collapse navbar-collapse" id="cpNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Professionals" asp-action="Index">Agenda tu hora</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Professionals" asp-action="Index">Profesionales</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contacto</a></li>
                        <li class="nav-item ms-lg-2 d-none d-lg-block">
                            <a class="btn cp-btn-primary btn-sm" asp-area="" asp-controller="Professionals" asp-action="Register">Soy psicólogo/a</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                @Html.Raw(TempData["SuccessMessageHtmlSuffix"] as string)
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        </div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="cp-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <img src="~/images/logo-on-dark.svg" alt="CentralPsi" height="38" class="mb-3" />
                    <p class="cp-footer-text">
                        CentralPsi es un espacio de agendamiento online (box virtual) que conecta a personas con
                        psicólogos y psicólogas verificados ante el Ministerio de Salud. No prestamos servicios de
                        salud directamente ni almacenamos antecedentes clínicos de pacientes.
                    </p>
                    <div class="cp-footer-social">
                        <a href="#" aria-label="Instagram">IG</a>
                        <a href="#" aria-label="Facebook">FB</a>
                        <a href="#" aria-label="LinkedIn">IN</a>
                    </div>
                </div>
                <div class="col-lg-2 col-6">
                    <h6>Navegación</h6>
                    <ul class="list-unstyled cp-footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li><a asp-controller="Professionals" asp-action="Index">Profesionales</a></li>
                        <li><a asp-controller="Professionals" asp-action="Register">Inscribirme como psicólogo/a</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contacto</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-6">
                    <h6>Legal</h6>
                    <ul class="list-unstyled cp-footer-links">
                        <li><a asp-controller="Home" asp-action="Terms">Términos y condiciones</a></li>
                        <li><a asp-controller="Home" asp-action="Terms" asp-fragment="reembolsos">Política de reembolsos</a></li>
                        <li><a asp-controller="Home" asp-action="Terms" asp-fragment="privacidad">Política de privacidad</a></li>
                        <li><a asp-controller="Home" asp-action="Terms" asp-fragment="cookies">Cookies</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6>Contacto</h6>
                    <ul class="list-unstyled cp-footer-links">
                        <li>Consultas: <a href="mailto:admin@centralpsi.cl">admin@centralpsi.cl</a></li>
                        <li>Reembolsos: <a href="mailto:reembolsos@centralpsi.cl">reembolsos@centralpsi.cl</a></li>
                    </ul>
                </div>
            </div>
            <hr class="cp-footer-divider" />
            <div class="cp-crisis-notice">
                <strong>¿Estás en una crisis o riesgo vital?</strong> CentralPsi no es un servicio de urgencia.
                Llama a <strong>Salud Responde 600 360 7777</strong> (opción salud mental) o a la
                <strong>Línea Libre 1515</strong>, disponibles las 24 horas en Chile.
            </div>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3">
                <span class="cp-copyright">&copy; @DateTime.Now.Year CentralPsi. Todos los derechos reservados.</span>
                <span class="cp-copyright">Valor de la sesión: $37.944 CLP</span>
            </div>
        </div>
    </footer>

    <div id="cpCookieBanner" class="cp-cookie-banner d-none">
        <div class="container d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            @if (hasAnalytics)
            {
                <p class="mb-0 small">
                    Usamos cookies estrictamente necesarias para que el sitio funcione, y cookies de analítica
                    (Google Analytics@(string.IsNullOrWhiteSpace(metaPixelId) ? "" : " y Meta Pixel")) para entender
                    cómo se usa el sitio y medir nuestras campañas. Puedes rechazarlas si prefieres no ser medido/a.
                    <a asp-controller="Home" asp-action="Terms" asp-fragment="cookies" class="text-decoration-underline">Más información</a>.
                </p>
                <div class="d-flex gap-2 flex-shrink-0">
                    <button type="button" id="cpCookieReject" class="btn cp-btn-outline btn-sm text-nowrap">Rechazar</button>
                    <button type="button" id="cpCookieAccept" class="btn cp-btn-primary btn-sm text-nowrap">Aceptar</button>
                </div>
            }
            else
            {
                <p class="mb-0 small">
                    Usamos solo cookies estrictamente necesarias para que el sitio funcione (seguridad de formularios
                    y mensajes de confirmación) — no usamos cookies de publicidad ni analítica.
                    <a asp-controller="Home" asp-action="Terms" asp-fragment="cookies" class="text-decoration-underline">Más información</a>.
                </p>
                <button type="button" id="cpCookieAccept" class="btn cp-btn-primary btn-sm text-nowrap">Entendido</button>
            }
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var STORAGE_KEY = 'cpCookieConsent';
            var banner = document.getElementById('cpCookieBanner');
            var gaId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(gaId));
            var pixelId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(metaPixelId));

            function loadGoogleAnalytics() {
                if (!gaId) return;
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
                document.head.appendChild(s);
                window.dataLayer = window.dataLayer || [];
                window.gtag = function () { window.dataLayer.push(arguments); };
                window.gtag('js', new Date());
                window.gtag('config', gaId);
            }

            function loadMetaPixel() {
                if (!pixelId) return;
                !function (f, b, e, v, n, t, s) {
                    if (f.fbq) return; n = f.fbq = function () {
                        n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
                    };
                    if (!f._fbq) f._fbq = n; n.push = n; n.loaded = true; n.version = '2.0';
                    n.queue = []; t = b.createElement(e); t.async = true; t.src = v;
                    s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
                }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
                window.fbq('init', pixelId);
                window.fbq('track', 'PageView');
            }

            function loadAnalytics() {
                loadGoogleAnalytics();
                loadMetaPixel();
            }

            var consent = localStorage.getItem(STORAGE_KEY);
            // Modelo opt-out: la analítica se activa de inmediato salvo que la persona ya la haya rechazado
            // antes. El aviso es informativo y ofrece "Rechazar" para quien prefiera no ser medido/a.
            if (consent !== 'denied') {
                loadAnalytics();
            }

            if (!banner) return;

            if (consent !== 'granted' && consent !== 'denied') {
                setTimeout(function () {
                    banner.classList.remove('d-none');
                }, 3000);
            }

            var acceptBtn = document.getElementById('cpCookieAccept');
            var rejectBtn = document.getElementById('cpCookieReject');
            if (acceptBtn) {
                acceptBtn.addEventListener('click', function () {
                    localStorage.setItem(STORAGE_KEY, 'granted');
                    banner.classList.add('d-none');
                    loadAnalytics();
                });
            }
            if (rejectBtn) {
                rejectBtn.addEventListener('click', function () {
                    localStorage.setItem(STORAGE_KEY, 'denied');
                    banner.classList.add('d-none');
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
