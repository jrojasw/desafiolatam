@model CentralPsi.Web.Models.ViewModels.BookingStartViewModel
@{
    ViewData["Title"] = "Confirma tu hora";
    var culture = new System.Globalization.CultureInfo("es-CL");
}

<section class="cp-section">
    <div class="container" style="max-width:720px;">
        <h1 class="cp-section-title">Confirma tu hora</h1>

        <div class="cp-crisis-notice mb-4" style="background:#eef6f5;color:var(--cp-primary-dark);">
            <strong>@Model.ProfessionalName</strong><br />
            @Model.StartLocal.ToString("dddd d 'de' MMMM 'de' yyyy, HH:mm 'hrs'", culture) (hora de Chile)<br />
            Valor de la sesión: <strong>$@Model.Amount.ToString("N0")</strong> CLP
        </div>

        <button type="button" class="btn cp-btn-outline btn-sm mb-4" data-bs-toggle="modal" data-bs-target="#cpSessionTipsModal">
            💡 Ver sugerencias para tu sesión
        </button>

        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <form asp-action="Confirm" method="post" class="cp-form-card">
            <input type="hidden" asp-for="ProfessionalId" />
            <input type="hidden" asp-for="StartUtc" />

            <div class="mb-3">
                <label asp-for="PatientFullName" class="form-label"></label>
                <input asp-for="PatientFullName" class="form-control" />
                <span asp-validation-for="PatientFullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PatientEmail" class="form-label"></label>
                <input asp-for="PatientEmail" class="form-control" />
                <span asp-validation-for="PatientEmail" class="text-danger small"></span>
                <div class="form-text">Aquí llegará el enlace de tu sesión y la confirmación del pago.</div>
            </div>
            <div class="mb-3">
                <label asp-for="PatientPhone" class="form-label"></label>
                <input asp-for="PatientPhone" class="form-control" />
                <span asp-validation-for="PatientPhone" class="text-danger small"></span>
            </div>

            <div class="form-check my-4">
                <input asp-for="IsForMinor" class="form-check-input" id="isForMinorCheck" />
                <label asp-for="IsForMinor" class="form-check-label small"></label>
            </div>

            <div id="minorFieldsWrapper" class="d-none">
                <div class="cp-crisis-notice mb-3" style="background:#eef6f5;color:var(--cp-primary-dark);">
                    Los datos de contacto de arriba (nombre, correo, teléfono) siguen siendo los tuyos: eres tú
                    quien agenda, recibe las confirmaciones y paga la sesión. Aquí solo indícanos para quién es.
                </div>
                <div class="mb-3">
                    <label asp-for="MinorFullName" class="form-label"></label>
                    <input asp-for="MinorFullName" class="form-control" />
                    <span asp-validation-for="MinorFullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="MinorAge" class="form-label"></label>
                    <input asp-for="MinorAge" type="number" min="0" max="17" class="form-control" style="max-width:120px;" />
                    <span asp-validation-for="MinorAge" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="GuardianRelationship" class="form-label"></label>
                    <select asp-for="GuardianRelationship" class="form-select">
                        <option value="">Selecciona una opción</option>
                        @foreach (var option in CentralPsi.Web.Models.ViewModels.BookingStartViewModel.GuardianRelationshipOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                    <span asp-validation-for="GuardianRelationship" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="GuardianConsentAccepted" class="form-check-input" />
                    <label asp-for="GuardianConsentAccepted" class="form-check-label small"></label>
                    <div><span asp-validation-for="GuardianConsentAccepted" class="text-danger small"></span></div>
                </div>
            </div>

            <div class="form-check my-4">
                <input asp-for="TermsAccepted" class="form-check-input" />
                <label asp-for="TermsAccepted" class="form-check-label small">
                    He leído y acepto los <a asp-controller="Home" asp-action="Terms" target="_blank">términos y condiciones</a>,
                    la política de reembolsos y entiendo que CentralPsi actúa únicamente como agendador entre el
                    paciente y el profesional, sin mantener contrato de prestación de servicios con ninguna de las
                    partes ni almacenar información clínica.
                </label>
                <div><span asp-validation-for="TermsAccepted" class="text-danger small"></span></div>
            </div>

            <button type="submit" class="btn cp-btn-primary btn-lg w-100">Continuar al pago</button>
        </form>
    </div>
</section>

<div class="modal fade" id="cpSessionTipsModal" tabindex="-1" aria-labelledby="cpSessionTipsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:1rem;">
            <div class="modal-header">
                <h5 class="modal-title" id="cpSessionTipsLabel">Antes de tu sesión</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Para que puedas aprovechar mejor tu sesión, te recomendamos:</p>
                <ul class="small mb-0">
                    <li class="mb-2">Busca un lugar <strong>silencioso y privado</strong>, sin otras personas alrededor.</li>
                    <li class="mb-2">Verifica que tengas <strong>buena iluminación</strong>, así el profesional puede verte con claridad.</li>
                    <li class="mb-2">Confirma que tu <strong>conexión a internet sea estable</strong> (evita usar solo datos móviles si puedes).</li>
                    <li class="mb-2">Prueba tu <strong>cámara y micrófono</strong> antes de la hora agendada.</li>
                    <li class="mb-2">Si no puedes estar en un lugar 100% privado, usar <strong>audífonos</strong> ayuda a resguardar tu confidencialidad.</li>
                    <li>Silencia las notificaciones del teléfono y evita interrupciones durante la sesión.</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn cp-btn-primary" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var tipsModal = new bootstrap.Modal(document.getElementById('cpSessionTipsModal'));
            tipsModal.show();

            var minorCheck = document.getElementById('isForMinorCheck');
            var minorWrapper = document.getElementById('minorFieldsWrapper');
            function toggleMinorFields() {
                minorWrapper.classList.toggle('d-none', !minorCheck.checked);
            }
            minorCheck.addEventListener('change', toggleMinorFields);
            toggleMinorFields();
        });
    </script>
}
