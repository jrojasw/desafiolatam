@model CentralPsi.Web.Models.ViewModels.WebpayRedirectViewModel
@{
    ViewData["Title"] = "Redirigiendo al pago";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Redirigiendo a pagar…</title>
</head>
<body style="font-family:Arial,sans-serif;text-align:center;padding-top:15vh;">
    <p>Redirigiendo para completar tu pago…</p>
    @if (Model.RedirectMethod == "GET")
    {
        <p><a id="cpPayLink" href="@Model.RedirectUrl">Continuar</a></p>
        <script>
            window.location.href = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RedirectUrl));
        </script>
    }
    else
    {
        <form id="webpayForm" action="@Model.RedirectUrl" method="POST">
            <input type="hidden" name="token_ws" value="@Model.Token" />
            <noscript>
                <button type="submit">Continuar</button>
            </noscript>
        </form>
        <p style="font-size:12px;color:#888;">Token: <code>@Model.Token</code></p>
        <p><button type="button" id="cpContinueNow" style="border:none;background:none;color:#2f6f6a;text-decoration:underline;cursor:pointer;">Continuar ahora</button></p>
        <script>
            var submitted = false;
            function submitNow() {
                if (submitted) return;
                submitted = true;
                document.getElementById('webpayForm').submit();
            }
            document.getElementById('cpContinueNow').addEventListener('click', submitNow);
            setTimeout(submitNow, 4000);
        </script>
    }
</body>
</html>
