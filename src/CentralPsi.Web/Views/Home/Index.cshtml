@model CentralPsi.Web.Models.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="cp-hero">
    @if (Model.Slides.Count > 0)
    {
        <div id="cpCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
            <div class="carousel-indicators">
                @for (var i = 0; i < Model.Slides.Count; i++)
                {
                    <button type="button" data-bs-target="#cpCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                }
            </div>
            <div class="carousel-inner">
                @for (var i = 0; i < Model.Slides.Count; i++)
                {
                    var slide = Model.Slides[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@Url.Content(slide.ImagePath)" class="d-block w-100" alt="@slide.Title">
                        @if (!string.IsNullOrWhiteSpace(slide.Title))
                        {
                            <div class="carousel-caption">
                                <h1>@slide.Title</h1>
                                @if (!string.IsNullOrWhiteSpace(slide.Subtitle))
                                {
                                    <p>@slide.Subtitle</p>
                                }
                                <a asp-controller="Professionals" asp-action="Index" class="btn cp-btn-primary btn-lg mt-2">Agenda tu hora</a>
                            </div>
                        }
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#cpCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#cpCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Siguiente</span>
            </button>
        </div>
    }
</section>

<section class="cp-section cp-why-us">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-5">
                <img src="~/images/seed/motivational.svg" alt="Cuidar tu mente también es salud" />
            </div>
            <div class="col-lg-7">
                <h2 class="cp-section-title">¿Por qué elegir CentralPsi?</h2>
                <p class="cp-section-subtitle">
                    Buscar ayuda psicológica puede sentirse abrumador. Por eso creamos un espacio simple, humano y
                    seguro para encontrar a la persona profesional indicada y agendar en minutos.
                </p>
                <div class="row gy-3">
                    <div class="col-sm-6 d-flex gap-3">
                        <div class="cp-feature-icon">✓</div>
                        <div>
                            <strong>Profesionales verificados</strong>
                            <p class="mb-0 text-muted">Cada psicólogo/a valida su título ante la Superintendencia de Salud antes de publicarse.</p>
                        </div>
                    </div>
                    <div class="col-sm-6 d-flex gap-3">
                        <div class="cp-feature-icon">$</div>
                        <div>
                            <strong>Pago seguro y transparente</strong>
                            <p class="mb-0 text-muted">Un valor único de $29.750 por sesión, procesado con Webpay Plus (Transbank).</p>
                        </div>
                    </div>
                    <div class="col-sm-6 d-flex gap-3">
                        <div class="cp-feature-icon">⏱</div>
                        <div>
                            <strong>Agenda flexible</strong>
                            <p class="mb-0 text-muted">Elige el día y horario disponible que más te acomode, 100% online.</p>
                        </div>
                    </div>
                    <div class="col-sm-6 d-flex gap-3">
                        <div class="cp-feature-icon">🔒</div>
                        <div>
                            <strong>Privacidad ante todo</strong>
                            <p class="mb-0 text-muted">No almacenamos antecedentes clínicos: solo actuamos como agendador entre tú y el profesional.</p>
                        </div>
                    </div>
                </div>
                <a asp-controller="Professionals" asp-action="Index" class="btn cp-btn-primary btn-lg mt-4">Ver profesionales disponibles</a>
            </div>
        </div>
    </div>
</section>

<section class="cp-section" style="background:#fff;border-top:1px solid var(--cp-border);border-bottom:1px solid var(--cp-border);">
    <div class="container">
        <h2 class="cp-section-title">Salud mental: noticias, consejos y estudios</h2>
        <p class="cp-section-subtitle">Contenido curado por nuestro equipo para acompañarte entre sesiones.</p>
        <div class="row gy-4">
            @foreach (var article in Model.News)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="cp-card">
                        <img src="@(string.IsNullOrEmpty(article.ImagePath) ? Url.Content("~/images/seed/motivational.svg") : Url.Content(article.ImagePath))" class="cp-news-image" alt="@article.Title" />
                        <div class="p-3">
                            <span class="cp-badge-category">@article.Category</span>
                            <h5 class="mt-2">@article.Title</h5>
                            <p class="text-muted small">@article.Summary</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.News.Count == 0)
        {
            <p class="text-muted">Aún no hay noticias publicadas.</p>
        }
    </div>
</section>

<section class="cp-section text-center">
    <div class="container">
        <h2 class="cp-section-title">¿Listo/a para dar el primer paso?</h2>
        <p class="cp-section-subtitle">Encuentra a tu psicólogo/a ideal y agenda tu primera sesión hoy mismo.</p>
        <a asp-controller="Professionals" asp-action="Index" class="btn cp-btn-primary btn-lg">Agenda tu hora</a>
    </div>
</section>
