@model CentralPsi.Web.Models.ViewModels.HomeIndexViewModel
@inject Microsoft.Extensions.Options.IOptions<CentralPsi.Web.Options.AppOptions> HomeAppOpts
@{
    ViewData["Title"] = "Inicio";
    var baseUrl = HomeAppOpts.Value.BaseUrl.TrimEnd('/');
    // Sin "sameAs": no hay ningún link real de Instagram/Facebook/LinkedIn configurado en el sitio todavía
    // (los íconos del footer son placeholders "#") - se agrega apenas existan URLs reales, no se inventan aquí.
    var medicalBusinessJsonLd = System.Text.Json.JsonSerializer.Serialize(new
    {
        context = "https://schema.org",
        type = "MedicalBusiness",
        name = "CentralPsi",
        url = $"{baseUrl}/",
        description = "CentralPsi conecta pacientes con psicólogos verificados por el Ministerio de Salud. Agenda tu hora online de forma simple y segura.",
        areaServed = "CL",
        priceRange = "$$"
    });
    // System.Text.Json no permite nombres de propiedad "@context"/"@type" directo en un objeto anónimo, así que
    // se corrigen con un reemplazo simple después de serializar.
    medicalBusinessJsonLd = medicalBusinessJsonLd.Replace("\"context\"", "\"@context\"").Replace("\"type\"", "\"@type\"");
}

@section Head {
    <script type="application/ld+json">
        @Html.Raw(medicalBusinessJsonLd)
    </script>
}

<section class="cp-audience-gate">
    <div class="cp-audience-gate__bg"></div>
    <a class="cp-audience-gate__half cp-audience-gate__half--patient" href="#cp-hero">
        <span class="cp-audience-gate__eyebrow">Soy paciente</span>
        <span class="cp-audience-gate__label">Quiero tomar<br />una hora</span>
        <span class="cp-audience-gate__arrow">→</span>
    </a>
    <a class="cp-audience-gate__half cp-audience-gate__half--pro" asp-controller="Professionals" asp-action="Register">
        <span class="cp-audience-gate__eyebrow">Soy profesional</span>
        <span class="cp-audience-gate__label">Soy<br />psicólogo/a</span>
        <span class="cp-audience-gate__arrow">→</span>
    </a>
</section>

<section class="cp-hero" id="cp-hero">
    @if (Model.Slides.Count > 0)
    {
        <div id="cpCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
            <div class="carousel-indicators">
                @for (var i = 0; i < Model.Slides.Count; i++)
                {
                    <button type="button" data-bs-target="#cpCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                }
            </div>
            <div class="carousel-inner">
                @for (var i = 0; i < Model.Slides.Count; i++)
                {
                    var slide = Model.Slides[i];
                    var mobileFocusX = slide.ImagePath switch
                    {
                        var p when p.Contains("slide-3-familia") => "44%",
                        var p when p.Contains("slide-4-agenda") => "74%",
                        _ => "50%"
                    };
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@Url.Content(slide.ImagePath)" class="d-block w-100" alt="@slide.Title" style="--cp-mobile-focus-x:@mobileFocusX;">
                        @if (!string.IsNullOrWhiteSpace(slide.Title))
                        {
                            <div class="carousel-caption">
                                <h1>@slide.Title</h1>
                                @if (!string.IsNullOrWhiteSpace(slide.Subtitle))
                                {
                                    <p>@slide.Subtitle</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(slide.ButtonUrl))
                                {
                                    <a href="@slide.ButtonUrl" class="btn cp-btn-primary btn-lg mt-2">@(string.IsNullOrWhiteSpace(slide.ButtonText) ? "Agenda tu hora" : slide.ButtonText)</a>
                                }
                                else
                                {
                                    <a asp-controller="Professionals" asp-action="Index" class="btn cp-btn-primary btn-lg mt-2">Agenda tu hora</a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#cpCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#cpCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Siguiente</span>
            </button>
        </div>
    }
</section>

<section class="cp-section cp-why-us">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-5">
                <img src="~/images/seed/why-us-verificado.jpg" alt="Cuidar tu mente también es salud" />
            </div>
            <div class="col-lg-7">
                <h2 class="cp-section-title">¿Por qué elegir CentralPsi?</h2>
                <p class="cp-section-subtitle">
                    Buscar ayuda psicológica puede sentirse abrumador. Por eso creamos un espacio simple, humano y
                    seguro para encontrar a la persona profesional indicada y agendar en minutos — sin letra chica.
                </p>
                <div class="row gy-3">
                    <div class="col-sm-6 d-flex gap-3">
                        <div class="cp-feature-icon">✓</div>
                        <div>
                            <strong>Verificación real, no solo declarada</strong>
                            <p class="mb-0 text-muted">Validamos el certificado de cada psicólogo/a directo contra el sistema oficial de la Superintendencia de Salud antes de publicar su perfil.</p>
                        </div>
                    </div>
                    <div class="col-sm-6 d-flex gap-3">
                        <div class="cp-feature-icon">$</div>
                        <div>
                            <strong>Un precio, sin sorpresas</strong>
                            <p class="mb-0 text-muted">$37.944 por sesión, el mismo valor sin importar a quién elijas del listado.</p>
                        </div>
                    </div>
                    <div class="col-sm-6 d-flex gap-3">
                        <div class="cp-feature-icon">⏱</div>
                        <div>
                            <strong>Agenda sin crear cuenta</strong>
                            <p class="mb-0 text-muted">Eliges el horario, pagas y quedas agendado/a en un solo paso — sin registrarte antes.</p>
                        </div>
                    </div>
                    <div class="col-sm-6 d-flex gap-3">
                        <div class="cp-feature-icon">🔒</div>
                        <div>
                            <strong>Privacidad real, no solo una promesa</strong>
                            <p class="mb-0 text-muted">No almacenamos fichas clínicas ni notas de sesión: solo actuamos como agendador entre tú y el profesional.</p>
                        </div>
                    </div>
                </div>
                <a asp-controller="Professionals" asp-action="Index" class="btn cp-btn-primary btn-lg mt-4">Ver profesionales disponibles</a>
            </div>
        </div>
    </div>
</section>

<section class="cp-section" style="background:#fff;border-top:1px solid var(--cp-border);border-bottom:1px solid var(--cp-border);">
    <div class="container">
        <h2 class="cp-section-title">Salud mental: noticias, consejos y estudios</h2>
        <p class="cp-section-subtitle">Contenido creado por nuestro equipo para acompañarte entre sesiones.</p>
        <div class="row gy-4">
            @foreach (var article in Model.News)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="cp-card">
                        <img src="@(string.IsNullOrEmpty(article.ImagePath) ? Url.Content("~/images/seed/motivational.svg") : Url.Content(article.ImagePath))" class="cp-news-image" alt="@article.Title" />
                        <div class="p-3">
                            <span class="cp-badge-category">@article.Category.ToDisplayName()</span>
                            <h5 class="mt-2">
                                <a asp-controller="News" asp-action="Details" asp-route-id="@article.Id" class="stretched-link text-decoration-none text-reset">@article.Title</a>
                            </h5>
                            <p class="text-muted small">@article.Summary</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.News.Count == 0)
        {
            <p class="text-muted">Aún no hay noticias publicadas.</p>
        }
    </div>
</section>

<section class="cp-section text-center">
    <div class="container">
        <h2 class="cp-section-title">¿Listo/a para dar el primer paso?</h2>
        <p class="cp-section-subtitle">Encuentra a tu psicólogo/a ideal y agenda tu primera sesión hoy mismo.</p>
        <a asp-controller="Professionals" asp-action="Index" class="btn cp-btn-primary btn-lg">Agenda tu hora</a>
    </div>
</section>
